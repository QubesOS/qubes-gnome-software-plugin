# this is not a library version
%define gs_plugin_version 23

%global debug_package %{nil}
Name: qubes-gnome-software-plugin-vm
Version: @VERSION@
Release: @REL@%{?dist}

Summary: Qubes gnome-software-plugin package for VM
License: GPLv2+
URL: https://www.qubes-os.org/

Source0: %{name}-%{version}.tar.gz
Source1: meson.build

BuildRequires: meson
BuildRequires: gcc
BuildRequires: gnome-software-devel
BuildRequires: gsettings-desktop-schemas-devel

Requires: gnome-software

%description
Qubes gnome-software-plugin package for VM.

%prep
%autosetup -p1 -n %{name}-%{version}
# override meson.build to handle just qubes part
cp %{SOURCE1} ./
echo "option('qubes', type: 'boolean', value: false, description: 'Qubes support')" > meson_options.txt

%build
%meson \
    -Dqubes=true
%meson_build

%install
%meson_install

%files
%{_libdir}/gnome-software/plugins-%{gs_plugin_version}/libgs_plugin_qubes.so
%{_datadir}/metainfo/org.gnome.Software.Plugin.Qubes.metainfo.xml

%changelog
@CHANGELOG@
